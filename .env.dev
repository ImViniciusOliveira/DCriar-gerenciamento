# .env.dev (esqueleto) - NÃO comite segredos reais
# Use este arquivo localmente para desenvolvimento. Substitua os placeholders.

# Portas expostas no HOST de Desenvolvimento
APP_PORT_DEV=8080
POSTGRES_PORT_DEV=5432
MINIO_PORT_DEV=9000
MINIO_CONSOLE_PORT_DEV=9001

# Banco de dados (dev)
POSTGRES_DB=your_dev_db
POSTGRES_USER=your_dev_user
POSTGRES_PASSWORD=your_dev_password

# MinIO (dev)
MINIO_ROOT_USER=your_minio_dev_user
MINIO_ROOT_PASSWORD=your_minio_dev_password
MINIO_BUCKET_NAME=your_minio_dev_bucket

# Variáveis para o minio-setup-dev
# Host/porta usados dentro da rede do compose
MINIO_HOST=minio-dev
MINIO_PORT=9000
# Tempo total de espera (segundos) antes de dar falha
WAIT_TIMEOUT=60
# Intervalo entre tentativas em segundos (padrão: 5s)
WAIT_INTERVAL=5

# Dicas opcionais (úteis se for rodar o backend fora do compose/IDE):
# URL do MinIO acessível pelo backend (quando rodando localmente pode ser http://localhost:9000)
# MINIO_URL=http://minio-dev:9000
# Expor também as chaves em formato esperado pelo Spring (opcional):
# MINIO_ACCESS_KEY=${MINIO_ROOT_USER}
# MINIO_SECRET_KEY=${MINIO_ROOT_PASSWORD}
# Exemplo SPRING datasource para rodar o backend localmente sem depender do compose:
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/${POSTGRES_DB}
# SPRING_DATASOURCE_USERNAME=${POSTGRES_USER}
# SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}

# Nota: este arquivo contém segredos locais quando preenchido. Mantenha a versão final fora do controle de versão.
