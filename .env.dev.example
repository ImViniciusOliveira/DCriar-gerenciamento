# .env.dev (esqueleto) - NÃO comite segredos reais
# Use este arquivo como base para criar o seu arquivo real de ambiente com valores reais.

# Portas expostas no HOST de Desenvolvimento
APP_PORT_DEV=8080
POSTGRES_PORT_DEV=5432
MINIO_PORT_DEV=9000
MINIO_CONSOLE_PORT_DEV=9001

# Banco de dados (dev)
POSTGRES_DB=your_dev_db
POSTGRES_USER=your_dev_user
POSTGRES_PASSWORD=your_dev_password

# MinIO (dev)
MINIO_ROOT_USER=your_minio_dev_user
MINIO_ROOT_PASSWORD=your_minio_dev_password
MINIO_BUCKET_NAME=your_minio_dev_bucket

# Host/porta usados dentro da rede do compose
MINIO_HOST=minio-dev
MINIO_PORT=9000
WAIT_TIMEOUT=60
WAIT_INTERVAL=5

# CORS (origens permitidas durante desenvolvimento)
CORS_ALLOWED_ORIGIN=http://localhost:4200

# Chave AES-256 em Base64 para criptografia dos dados sensíveis das vendas.
DATA_ENCRYPTION_KEY=your_base64_aes256_key

# URL e credenciais para o backend acessar o MinIO (quando rodar fora do compose)
MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=your_minio_dev_user
MINIO_SECRET_KEY=your_minio_dev_password

# SPRING (opcional para rodar backend fora do compose)
SPRING_DATASOURCE_URL="jdbc:postgresql://localhost:5432/${POSTGRES_DB}"
SPRING_DATASOURCE_USERNAME="${POSTGRES_USER}"
SPRING_DATASOURCE_PASSWORD="${POSTGRES_PASSWORD}"

# Copie este arquivo para o caminho do seu arquivo real de ambiente e substitua os placeholders antes de usar.
