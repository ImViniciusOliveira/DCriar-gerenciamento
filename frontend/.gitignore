# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Build output
/dist
/tmp
/out-tsc
/bazel-out

# Dependencies
/node_modules

# VS Code - Compartilhando configurações com a equipe
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# IDEs & Editors - Regras específicas que não estão no .gitignore raiz
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Miscellaneous
/.angular/cache
.sass-cache/
/connect.lock
/coverage
/libpeerconnection.log
testem.log
__screenshots__/
