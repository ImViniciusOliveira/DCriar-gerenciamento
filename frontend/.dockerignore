# frontend/.dockerignore

# Node modules and build output
node_modules/
dist/
build/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Env files (secrets não devem ser copiados para a imagem)
.env
.env.*

# Editor/OS files
.DS_Store
.idea/
.vscode/

# Temporary/cache
.cache/

# Git
.git/
.gitignore

