# =================================================
# ARQUIVO DE PRODUÇÃO (esqueleto) - NÃO comite segredos reais
# Copie este arquivo para /etc/dcriar/.env.prod e preencha com valores reais
# =================================================

# Versão da aplicação (tag usada nas imagens backend/frontend)
APP_VERSION=1.0.0

# Registry e Nomes das Imagens
DOCKER_REGISTRY_USER=your-docker-hub-username
BACKEND_IMAGE_NAME=dcriar-api
FRONTEND_IMAGE_NAME=dcriar-frontend

# Portas expostas no HOST de Produção.
# Mantenha 80 para redirect e healthcheck; 443 atende o frontend e a API proxied via HTTPS.
FRONTEND_HTTP_PORT=80
FRONTEND_HTTPS_PORT=443

# Hostname usado no certificado e no server_name do nginx.
# Em rede local, prefira um DNS interno/hostname estável em vez de IP puro sempre que possível.
FRONTEND_SERVER_NAME=seu-frontend.exemplo.com

# TLS no frontend/proxy.
# Quando true, o nginx redireciona HTTP para HTTPS e exige os arquivos abaixo montados no container.
FRONTEND_TLS_ENABLED=true
TLS_CERT_FILE=/etc/dcriar/tls/fullchain.crt
TLS_KEY_FILE=/etc/dcriar/tls/private.key

# Imagens derivam de APP_VERSION (docker-compose usa imviniciusoliveira/dcriar-api:${APP_VERSION} etc.)
# Se precisar customizar nomes de imagens, ajuste diretamente o docker-compose.prod.yml.

# Variáveis para o serviço do PostgreSQL (preencha com valores reais)
POSTGRES_DB=your_postgres_db
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password

# Variáveis para o serviço do MinIO (preencha com valores reais)
MINIO_ROOT_USER=your_minio_user
MINIO_ROOT_PASSWORD=your_minio_password
MINIO_BUCKET_NAME=your_minio_bucket

# CORS para acessos diretos ao backend, se existirem.
# No fluxo recomendado, o frontend usa a mesma origem HTTPS e encaminha /api para o backend.
CORS_ALLOWED_ORIGIN=https://seu-frontend.exemplo.com

# URL completa do MinIO acessível pelo backend
MINIO_URL=http://minio-prod:9000
MINIO_ACCESS_KEY=your_minio_user
MINIO_SECRET_KEY=your_minio_password

# Chave AES-256 em Base64 usada para criptografar dados sensíveis das vendas em repouso.
DATA_ENCRYPTION_KEY=your_base64_aes256_key

# TLS:
# - Os certificados ficam fora da imagem, montados por volume no container frontend.
# - Em LAN, você pode usar CA interna/mkcert e instalar a CA nas máquinas clientes.
#
# Observação: este arquivo é somente um esqueleto. Proteja o arquivo real em produção
# (ex: /etc/dcriar/.env.prod com chmod 600) e não adicione segredos aqui no repositório.
